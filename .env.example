# Copy this file to .env and fill only the values you need.
# Do not commit real API keys.

# Artifact live tests use one OpenRouter key for every runtime.
OPENROUTER_API_KEY=
AGENT_DRIVER_LIVE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_DRIVER_LIVE_OPENROUTER_ANTHROPIC_BASE_URL=https://openrouter.ai/api
AGENT_DRIVER_LIVE_OPENAI_MODEL=openai/gpt-5.6-luna
AGENT_DRIVER_LIVE_OPENAI_REASONING_EFFORT=medium
AGENT_DRIVER_LIVE_ANTHROPIC_MODEL=anthropic/claude-sonnet-5
AGENT_DRIVER_LIVE_OPENCODE_MODELS=["openrouter/moonshotai/kimi-k3","openrouter/deepseek/deepseek-v4-flash","openrouter/z-ai/glm-5.2","openrouter/qwen/qwen3.7-plus"]

# The release workflow overrides this with the unpacked NPM artifact.
# AGENT_DRIVER_LIVE_ARTIFACT=/path/to/package/dist/driver.mjs

# Optional runtime executable overrides.
# MOSOO_OPENAI_RUNTIME_EXECUTABLE=/path/to/openai-runtime
# MOSOO_CLAUDE_CODE_EXECUTABLE=/path/to/mosoo-claude-code
# AGENT_DRIVER_LIVE_OPENCODE_COMMAND=/path/to/opencode

# Generic ACP fallback overrides for non-live use.
# MOSOO_ACP_FALLBACK_COMMAND=opencode
# MOSOO_ACP_FALLBACK_ARGS=["acp","--pure"]
# MOSOO_ACP_AUTH_METHOD_ID=
