{
  "name": "@mosoo/agent-driver",
  "version": "0.1.0",
  "private": false,
  "description": "Runtime-neutral Agent Driver and AI agent harness for Claude Agent SDK, Codex app-server, and ACP inside isolated sandboxes.",
  "homepage": "https://github.com/langgenius/mosoo-agent-driver",
  "bugs": {
    "url": "https://github.com/langgenius/mosoo-agent-driver/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langgenius/mosoo-agent-driver.git"
  },
  "bin": {
    "agent-driver": "./dist/driver.mjs"
  },
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./boot": {
      "types": "./dist/types/boot.d.ts",
      "default": "./src/boot.ts"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "default": "./src/runtime.ts"
    },
    "./paths": {
      "types": "./dist/types/paths.d.ts",
      "default": "./src/paths.ts"
    },
    "./events": {
      "types": "./dist/types/events.d.ts",
      "default": "./src/events.ts"
    },
    "./contract": {
      "types": "./dist/types/contract/index.d.ts",
      "default": "./src/contract/index.ts"
    },
    "./orpc": {
      "types": "./dist/types/orpc.d.ts",
      "default": "./src/orpc.ts"
    },
    "./provider-output": {
      "types": "./dist/types/provider-output.d.ts",
      "default": "./src/provider-output.ts"
    },
    "./cma-http": {
      "types": "./dist/types/cma-http.d.ts",
      "default": "./src/cma-http.ts"
    },
    "./cma-sdk": {
      "types": "./dist/types/cma-sdk.d.ts",
      "default": "./src/cma-sdk.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bench": "bun bench/ttft-bench.ts",
    "build": "vp run build:types && bun build src/bin/driver.ts --outfile dist/driver.mjs --target bun --format esm --bundle",
    "build:types": "rm -rf dist/types && vp exec tsc -p tsconfig.types.json",
    "check": "vp run tc && vp run test && vp run build",
    "image:build": "vp run build && buildah build -t agent-driver:local .",
    "lint": "vp lint src tests",
    "prepack": "vp run build",
    "tc": "vp exec tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:live:anthropic": "bun test tests/claude-agent-sdk-live.test.ts",
    "test:live:openai": "bun test tests/openai-app-server-live.test.ts",
    "test:live:opencode": "AGENT_DRIVER_LIVE_OPENCODE=1 bun test tests/opencode-acp-live.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.211",
    "@anthropic-ai/sdk": "0.111.0",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@orpc/client": "^1.14.3",
    "fflate": "^0.8.3",
    "vestig": "^0.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.144.5",
    "@types/bun": "1.3.14",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.5"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
